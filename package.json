{
  "name": "omni-async-monorepo",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "docs:dev": "pnpm --filter @omni-async/docs dev",
    "docs:build": "pnpm --filter @omni-async/docs build",
    "release": "bumpp -r --sign --execute \"pnpm install --lockfile-only && pnpm release:verify\"",
    "release:verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "release:publish": "pnpm -r publish --access public --no-git-checks",
    "bench": "turbo run bench",
    "bench-compare": "turbo run bench-compare",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "bumpp": "^12.2.2",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.20.0"
}
