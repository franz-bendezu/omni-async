{
  "name": "omni-async",
  "version": "0.1.0",
  "description": "Framework-agnostic async state primitives with adapters for React, Vue, and Svelte.",
  "homepage": "https://franz-bendezu.github.io/omni-async",
  "bugs": {
    "url": "https://github.com/franz-bendezu/omni-async/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franz-bendezu/omni-async.git",
    "directory": "packages/omni-async"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./react": "./dist/react.mjs",
    "./svelte": "./dist/svelte.mjs",
    "./vue": "./dist/vue.mjs",
    "./package.json": "./package.json",
    "./core": "./dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@omni-async/core": "workspace:*",
    "@omni-async/react": "workspace:*",
    "@omni-async/svelte": "workspace:*",
    "@omni-async/vue": "workspace:*"
  }
}
