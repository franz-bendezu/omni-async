{
  "name": "@omni-async/core",
  "version": "0.0.1",
  "description": "Framework-agnostic async state primitives for TypeScript.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "bench": "vitest bench --run --project=bench --outputJson=.bench/results-baseline.json",
    "bench-compare": "vitest bench --run --project=bench --compare=.bench/results-baseline.json",
    "clean": "rm -rf dist"
  }
}
