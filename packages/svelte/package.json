{
  "name": "@omni-async/svelte",
  "version": "0.0.1",
  "description": "Typed Svelte stores for asynchronous queries, fetches, and actions.",
  "homepage": "https://github.com/franz-bendezu/omni-async#readme",
  "bugs": {
    "url": "https://github.com/franz-bendezu/omni-async/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franz-bendezu/omni-async.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@omni-async/core": "workspace:*"
  },
  "devDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
