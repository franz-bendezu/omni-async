{
  "name": "@omni-async/vue",
  "version": "0.1.0",
  "description": "Typed Vue composables for asynchronous queries, fetches, and actions.",
  "homepage": "https://franz-bendezu.github.io/omni-async/frameworks/vue",
  "bugs": {
    "url": "https://github.com/franz-bendezu/omni-async/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franz-bendezu/omni-async.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
