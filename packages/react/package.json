    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@omni-async/core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  }
}
